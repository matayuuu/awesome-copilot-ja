{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "chat-cards",
  "description": "GHCP canvas のインタラクティブなカードデッキ。タブカード、表、SVG チャート、セクションの表示/非表示、番号付きアウトライン、レンダリング済み Markdown 文書、動画クリップ、送信内容がプロンプトとして会話に戻るフォームを提供します。",
  "version": "0.1.0",
