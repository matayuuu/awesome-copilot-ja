{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "where-was-i",
  "description": "開発コンテキスト（ブランチ、コミット、未コミットの作業、PRの手がかり）を再構成し、すぐに再開できるプロンプトを起動します。",
  "version": "1.1.0",
  "author": {
    "name": "Aaron Powell",
    "url": "https://github.com/aaronpowell"
  },
  "keywords": [
    "branch-state",
    "developer-context",
    "git-history",
    "interrupt-recovery",
    "pull-request-context",
    "resume-work"
  ],
  "extensions": {
    "com.github.copilot": {
      "logo": "assets/preview.png"
    },
    "com.github.awesome-copilot": {
      "extensions": [
        "./extensions/where-was-i"
      ]
    }
  }
}
