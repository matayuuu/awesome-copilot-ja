{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "the-workshop",
  "description": "AIエージェント間の取り次ぎ役をやめて、チームを直接指揮しましょう。Workshopは長時間稼働するAIエージェント（デスク）を同じ作業、同じ部屋に集め、それぞれのメモリと履歴を持たせたまま1つのワークスペースを共有します。作業を伝言するのではなく、直接指揮できます。",
  "version": "0.1.0",
  "author": {
    "name": "jennyf19"
  },
  "repository": "https://github.com/jennyf19/the-workshop",
  "license": "MIT",
  "keywords": [
    "multi-agent",
    "coordination",
    "desks",
    "persistent-memory",
    "agent-signals",
    "developer-experience"
  ],
  "extensions": {
    "com.github.awesome-copilot": {
      "agents": [
        "./agents/workshop-ta.md"
      ],
      "skills": [
        "./skills/bench-read/",
        "./skills/desk-journal/",
        "./skills/desk-open/",
        "./skills/signal-write/",
        "./skills/workshop-create/"
      ],
      "extensions": [
        "./extensions/signals-dashboard"
      ]
    }
  }
}
