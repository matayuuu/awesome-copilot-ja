{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "react19-upgrade",
  "description": "React 18のコードベースをReact 19へアップグレードするための、専門エージェントとSkillを備えたエンタープライズ向け移行ツールキット。監査、依存関係、ソースコード移行、テストを担当する機能を含みます。ReactDOM.render、forwardRef、defaultProps、レガシーコンテキスト、文字列refなどの非推奨APIの削除に対応します。",
  "version": "1.0.0",
  "keywords": [
    "react19",
    "react",
    "migration",
    "upgrade",
    "hooks",
    "modern-react"
  ],
  "author": {
    "name": "Awesome Copilot Community"
  },
  "repository": "https://github.com/github/awesome-copilot",
  "license": "MIT",
  "extensions": {
    "com.github.awesome-copilot": {
      "agents": [
        "./agents/react19-auditor.md",
        "./agents/react19-commander.md",
        "./agents/react19-dep-surgeon.md",
        "./agents/react19-migrator.md",
        "./agents/react19-test-guardian.md"
      ],
      "skills": [
        "./skills/react19-concurrent-patterns/",
        "./skills/react19-source-patterns/",
        "./skills/react19-test-patterns/"
      ]
    }
  }
}
