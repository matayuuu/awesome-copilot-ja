{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "noob-mode",
  "description": "技術者ではないCopilot CLIユーザー向けの平易な言葉への翻訳レイヤー。承認プロンプト、エラーメッセージ、技術的な出力をすべて、色分けしたリスク表示付きの、明確で専門用語の少ない日本語に翻訳します。",
  "version": "1.0.0",
  "author": {
    "name": "Awesome Copilot Community"
  },
  "repository": "https://github.com/github/awesome-copilot",
  "license": "MIT",
  "keywords": [
    "accessibility",
    "plain-english",
    "non-technical",
    "beginner",
    "translation",
    "copilot-cli",
    "ux"
  ],
  "extensions": {
    "com.github.awesome-copilot": {
      "skills": [
        "./skills/noob-mode/"
      ]
    }
  }
}
